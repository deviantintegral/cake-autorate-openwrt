# /etc/config/cake-autorate -- UCI configuration for the cake-autorate package.
#
# One named section per cake-autorate instance:
#
#     config cake-autorate 'primary'
#
# The SECTION NAME IS THE INSTANCE ID. It must match [A-Za-z0-9_]+ and it is
# what the config bridge, the procd service and the log file are named after:
#
#     generated daemon config   /etc/cake-autorate/config.<name>.sh
#     log file / status source  /var/log/cake-autorate.<name>.log
#
# Add a second section with a different name for a second WAN -- there is no
# shared or global section, so two instances cannot collide. A commented
# two-instance example is at the bottom of this file.
#
# Every option below is one of the 66 options upstream cake-autorate 3.2.2
# actually implements (docs/upstream-option-inventory.md). DO NOT INVENT KEYS:
# a key the daemon does not know is a fatal startup error. `enabled` is the one
# package-local key -- it gates procd and is never written to the daemon config.
#
# Types are strict upstream: values documented as floats must keep their
# decimal point (0.3, 30.0, 1.0), integers must not have one, and no value may
# be negative. See docs/uci-schema.md and docs/uci-option-schema.tsv.

config cake-autorate 'primary'

	# Master switch for this instance (procd). Set to 1 once the interfaces and
	# rates below are correct for your line.
	option enabled '0'

	# ---- Essentials -- edit these and nothing else for a working setup
	# dl_if is the ingress (download) device, normally the sqm-scripts IFB for your
	# WAN (e.g. ifb4eth1 for WAN eth1); ul_if is the WAN egress device itself.
	# Neither may be empty: an empty value is a fatal error for the daemon.
	# Rates are Kbit/s and must satisfy  min <= base <= max  in each direction.
	# Set base to your provisioned rate, min to the worst rate you will tolerate
	# and max to the best the line ever achieves.
	option dl_if 'ifb-wan'
	option ul_if 'wan'
	option min_dl_shaper_rate_kbps '5000'
	option base_dl_shaper_rate_kbps '20000'
	option max_dl_shaper_rate_kbps '80000'
	option min_ul_shaper_rate_kbps '5000'
	option base_ul_shaper_rate_kbps '20000'
	option max_ul_shaper_rate_kbps '35000'

	# ---- Shaper behaviour -- how aggressively rates are moved
	option adjust_dl_shaper_rate '1'
	option adjust_ul_shaper_rate '1'
	option min_shaper_rates_enforcement '0'
	option shaper_rate_min_adjust_down_bufferbloat '0.99'
	option shaper_rate_max_adjust_down_bufferbloat '0.75'
	option shaper_rate_adjust_up_load_high '1.04'
	option shaper_rate_adjust_down_load_low '0.99'
	option shaper_rate_adjust_up_load_low '1.01'
	option high_load_thr '0.75'
	option bufferbloat_refractory_period_ms '300'
	option decay_refractory_period_ms '1000'

	# ---- Pingers -- probe backend, concurrency and rate
	option pinger_binary 'fping'
	option no_pingers '6'
	option reflector_ping_interval_s '0.3'
	option ping_extra_args ''
	option ping_prefix_string ''

	# ---- Reflectors -- the ICMP targets and their health management
	# The first no_pingers entries are used; the rest are spares for rotation.
	# IPv4 and IPv6 literals are both accepted.

	list reflectors '1.1.1.1'
	list reflectors '1.0.0.1'
	list reflectors '8.8.8.8'
	list reflectors '8.8.4.4'
	list reflectors '9.9.9.9'
	list reflectors '9.9.9.10'
	list reflectors '9.9.9.11'
	list reflectors '94.140.14.15'
	list reflectors '94.140.14.140'
	list reflectors '94.140.14.141'
	list reflectors '94.140.15.15'
	list reflectors '94.140.15.16'
	list reflectors '64.6.65.6'
	list reflectors '156.154.70.1'
	list reflectors '156.154.70.2'
	list reflectors '156.154.70.3'
	list reflectors '156.154.70.4'
	list reflectors '156.154.70.5'
	list reflectors '156.154.71.1'
	list reflectors '156.154.71.2'
	list reflectors '156.154.71.3'
	list reflectors '156.154.71.4'
	list reflectors '156.154.71.5'
	list reflectors '208.67.220.2'
	list reflectors '208.67.220.123'
	list reflectors '208.67.220.220'
	list reflectors '208.67.222.2'
	list reflectors '208.67.222.123'
	list reflectors '185.228.168.9'
	list reflectors '185.228.168.10'

	option randomize_reflectors '1'
	option reflector_health_check_interval_s '1.0'
	option reflector_response_deadline_s '1.0'
	option reflector_misbehaving_detection_window '60'
	option reflector_misbehaving_detection_thr '3'
	option reflector_replacement_interval_mins '60'
	option reflector_comparison_interval_mins '1'
	option reflector_sum_owd_baselines_delta_thr_ms '20.0'
	option reflector_owd_delta_ewma_delta_thr_ms '10.0'

	# ---- Delay measurement and bufferbloat detection
	option dl_owd_delta_thr_ms '30.0'
	option ul_owd_delta_thr_ms '30.0'
	option dl_avg_owd_delta_thr_ms '60.0'
	option ul_avg_owd_delta_thr_ms '60.0'
	option monitor_achieved_rates_interval_ms '200'
	option bufferbloat_detection_window '6'
	option bufferbloat_detection_thr '3'
	option alpha_baseline_increase '0.001'
	option alpha_baseline_decrease '0.9'
	option alpha_delta_ewma '0.095'

	# ---- Idle, sleep and stall handling
	option enable_sleep_function '1'
	option connection_active_thr_kbps '2000'
	option sustained_idle_sleep_thr_s '60.0'
	option startup_wait_s '0.0'
	option stall_detection_thr '5'
	option connection_stall_thr_kbps '10'
	option global_ping_response_timeout_s '10.0'
	option if_up_check_interval_s '10.0'

	# ---- Logging and output
	# log_to_file, output_summary_stats, log_file_path_override and
	# log_DEBUG_messages_to_syslog are PACKAGE-MANAGED: the config bridge
	# overwrites whatever is set here, because the LuCI status view and the
	# collectd feed are parsed out of /var/log/cake-autorate.<instance>.log.
	# The four log_file_buffer_*/log_file_max_* values are user-tunable but the
	# bridge clamps them to a sane non-zero range.
	option output_processing_stats '0'
	option output_load_stats '0'
	option output_reflector_stats '0'
	option output_summary_stats '1'
	option output_cake_changes '0'
	option debug '0'
	option log_DEBUG_messages_to_syslog '0'
	option log_to_file '1'
	option log_file_max_time_mins '10'
	option log_file_max_size_KB '2000'
	option log_file_path_override ''
	option log_file_buffer_size_B '512'
	option log_file_buffer_timeout_ms '500'
	option log_file_export_compress '1'

# ---- Second instance (multi-WAN) -- uncomment and adjust.
#
# Only the Essentials need to be listed: any option a section omits simply
# keeps the value the package/daemon defaults give it.
#
# NOTE the minimum rates below: neither may be BELOW connection_active_thr_kbps
# (2000 above), because the daemon treats that as a fatal config error and exits
# at startup -- before it opens its log file, so the reason appears in `logread`
# only. On an uplink slower than 2 Mbit/s, lower connection_active_thr_kbps to
# match instead of setting a min rate under it.
#
#config cake-autorate 'secondary'
#	option enabled '1'
#	option dl_if 'ifb4eth2'
#	option ul_if 'eth2'
#	option min_dl_shaper_rate_kbps '2000'
#	option base_dl_shaper_rate_kbps '10000'
#	option max_dl_shaper_rate_kbps '25000'
#	option min_ul_shaper_rate_kbps '2000'
#	option base_ul_shaper_rate_kbps '4000'
#	option max_ul_shaper_rate_kbps '8000'
