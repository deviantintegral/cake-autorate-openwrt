#!/bin/sh /etc/rc.common
# STUB -- owned by task 5 (procd service).
#
# Task 2 created this file so the package installs an /etc/init.d/cake-autorate.
# Task 5 replaces the body with the real procd service: run the config bridge
# (/usr/libexec/cake-autorate/cake-autorate-bridge.sh) to render
# /etc/cake-autorate/config.<instance>.sh from UCI, then supervise
# /usr/lib/cake-autorate/launcher.sh.
#
# Invariants task 5 must preserve:
#   * export CAKE_AUTORATE_CONFIG_PREFIX=/etc/cake-autorate  (keeps generated
#     config out of /usr/lib; /etc/cake-autorate is NOT in upstream's
#     POSSIBLE_CONFIG_PREFIXES, so the env var is mandatory).
#   * /usr/lib/cake-autorate is already in upstream's POSSIBLE_SCRIPT_PREFIXES,
#     so CAKE_AUTORATE_SCRIPT_PREFIX is not required.

START=97
STOP=4
USE_PROCD=1

CA_SCRIPT_PREFIX=/usr/lib/cake-autorate
CA_CONFIG_PREFIX=/etc/cake-autorate

start_service() {
	procd_open_instance
	procd_set_param env CAKE_AUTORATE_CONFIG_PREFIX="$CA_CONFIG_PREFIX"
	procd_set_param command "$CA_SCRIPT_PREFIX/launcher.sh"
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cake-autorate"
}
