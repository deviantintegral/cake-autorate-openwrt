#!/bin/sh /etc/rc.common
# procd service for cake-autorate -- one supervised daemon per ENABLED UCI
# instance. Owned by plan 01 / task 5.
#
# shellcheck shell=ash
# `local` is used throughout: it is a valid ash builtin (the interpreter
# /etc/rc.common runs under) but unknown to POSIX sh, so silence SC3043.
# START / STOP / USE_PROCD look unused to shellcheck but are read externally by
# /etc/rc.common (the interpreter in the shebang), so silence SC2034 for them.
# shellcheck disable=SC3043,SC2034
#
# LIFECYCLE
#   start / reload
#     1. Run the config bridge with NO ARGUMENTS. The bridge reads live UCI and
#        writes /etc/cake-autorate/config.<name>.sh for every ENABLED instance
#        while PRUNING the config of any removed/disabled instance. The init
#        script deliberately does NOT gate config generation on `enabled` -- the
#        bridge is the sole arbiter of that. A non-zero bridge exit aborts the
#        (re)start so a half-written config never reaches the daemon.
#     2. For each ENABLED UCI section, open one procd instance named after the
#        section, running one upstream daemon against that section's generated
#        config file. procd supervises and respawns each independently, so a
#        crash or restart of one WAN never disturbs another.
#
# PER-INSTANCE NAMESPACING
#   Everything is keyed off the section name, which is the instance id:
#     generated config   /etc/cake-autorate/config.<name>.sh   (passed as $1)
#     daemon run dir      /var/run/cake-autorate/<name>         (daemon-derived)
#     log / status file   /var/log/cake-autorate.<name>.log     (daemon-derived)
#   cake-autorate.sh derives the run dir and log path itself from the config
#   filename (regex config.<id>.sh), so two WANs can never collide and this
#   script adds no shared pid/run files of its own.
#
# INVARIANTS (from the task-2 install layout / upstream prefix search)
#   * export CAKE_AUTORATE_CONFIG_PREFIX=/etc/cake-autorate -- /etc/cake-autorate
#     is NOT in upstream's POSSIBLE_CONFIG_PREFIXES, so without this env var the
#     daemon's config-prefix probe fails even though we pass the full path.
#   * /usr/lib/cake-autorate IS in upstream's POSSIBLE_SCRIPT_PREFIXES, so
#     CAKE_AUTORATE_SCRIPT_PREFIX is not required.
#   * The CAKE qdisc is owned by sqm-scripts; this service never touches tc.
#
# START ordering: sqm-scripts is START=50 and must have created the CAKE qdisc
# before cake-autorate begins adjusting its bandwidth, so START is well after.

START=97
STOP=4

USE_PROCD=1

# Overridable so the off-device test harness can point at fixtures. On a target
# these resolve to the task-2 install paths.
CA_SCRIPT_PREFIX="${CA_SCRIPT_PREFIX:-/usr/lib/cake-autorate}"
CA_CONFIG_PREFIX="${CA_CONFIG_PREFIX:-/etc/cake-autorate}"
CA_BRIDGE="${CA_BRIDGE:-/usr/libexec/cake-autorate/cake-autorate-bridge.sh}"

# Open one procd instance for a single ENABLED section. Invoked by
# config_foreach, so $1 is the section (== instance) name.
start_instance() {
	local section="$1"
	local enabled config_file

	config_get_bool enabled "$section" enabled 0
	[ "${enabled:-0}" = 1 ] || return 0

	config_file="$CA_CONFIG_PREFIX/config.$section.sh"
	if [ ! -f "$config_file" ]; then
		# The bridge is the arbiter of `enabled`; if it produced no config for a
		# section we consider enabled, honour the bridge and start nothing.
		logger -t cake-autorate -p daemon.warn \
			"instance '$section' enabled but $config_file not generated; skipping"
		return 0
	fi

	procd_open_instance "$section"
	procd_set_param command "$CA_SCRIPT_PREFIX/cake-autorate.sh" "$config_file"
	procd_set_param env CAKE_AUTORATE_CONFIG_PREFIX="$CA_CONFIG_PREFIX"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load cake-autorate

	# Whole-world sync + prune of every instance config from live UCI. Abort the
	# (re)start on failure so instances never launch against a stale/partial config.
	if ! "$CA_BRIDGE"; then
		logger -t cake-autorate -p daemon.err \
			"config bridge ($CA_BRIDGE) failed; refusing to (re)start instances"
		return 1
	fi

	config_foreach start_instance cake-autorate
}

# Save & Apply / `reload` re-runs the bridge and re-declares the instance set.
# Re-invoking start_service lets procd reconcile: it starts a newly-enabled
# (cold) instance, stops a now-disabled one and restarts a changed one, without
# disturbing the instances whose config is unchanged.
reload_service() {
	start_service
}

service_triggers() {
	procd_add_reload_trigger "cake-autorate"
}
