# /etc/config/sqm -- two SQM CAKE instances, one per test WAN.
# sqm-scripts creates the CAKE qdisc on the egress device and an ifb4<dev>
# device carrying the ingress CAKE qdisc. cake-autorate then *changes* the
# bandwidth of those existing qdiscs (it never creates them), so SQM must run
# first (init START=50 vs cake-autorate START=97).
#
# Initial download/upload values here are deliberately low; cake-autorate
# overrides the CAKE bandwidth from its own base_* rates the moment it starts.

config queue 'wan'
	option interface 'eth1'
	option enabled '1'
	option qdisc 'cake'
	option script 'layer_cake.qos'
	option qdisc_advanced '0'
	option linklayer 'none'
	option download '3000'
	option upload '3000'

config queue 'wan2'
	option interface 'eth0'
	option enabled '1'
	option qdisc 'cake'
	option script 'layer_cake.qos'
	option qdisc_advanced '0'
	option linklayer 'none'
	option download '3000'
	option upload '3000'
