# /etc/config/cake-autorate -- TWO enabled instances (multi-WAN).
#
# Only keys that differ from the upstream defaults are set; the config bridge
# fills the rest and force-enables the logging keys (log_to_file=1,
# output_summary_stats=1) so a parseable SUMMARY stream exists.
#
#   primary   -> shapes eth1 / ifb4eth1  (reflector 10.0.2.2) -- gets the load
#   secondary -> shapes eth0 / ifb4eth0  (reflector 10.0.3.2) -- proves isolation
#
# base_* rates are deliberately low so a modest download saturates the ingress
# CAKE qdisc, driving the control loop to raise the rate toward max_*. The
# up-adjust factor is bumped to 1.10 so the movement is fast and unambiguous
# inside the test window (still a valid upstream value >= 1).

config cake-autorate 'primary'
	option enabled '1'
	option dl_if 'ifb4eth1'
	option ul_if 'eth1'
	option min_dl_shaper_rate_kbps '2000'
	option base_dl_shaper_rate_kbps '3000'
	option max_dl_shaper_rate_kbps '60000'
	option min_ul_shaper_rate_kbps '2000'
	option base_ul_shaper_rate_kbps '3000'
	option max_ul_shaper_rate_kbps '30000'
	option shaper_rate_adjust_up_load_high '1.10'
	option pinger_binary 'fping'
	option no_pingers '1'
	option reflector_ping_interval_s '0.2'
	option randomize_reflectors '0'
	option enable_sleep_function '0'
	option connection_active_thr_kbps '2000'
	option output_cake_changes '1'
	option debug '0'
	list reflectors '10.0.2.2'

config cake-autorate 'secondary'
	option enabled '1'
	option dl_if 'ifb4eth0'
	option ul_if 'eth0'
	option min_dl_shaper_rate_kbps '2000'
	option base_dl_shaper_rate_kbps '5000'
	option max_dl_shaper_rate_kbps '30000'
	option min_ul_shaper_rate_kbps '2000'
	option base_ul_shaper_rate_kbps '5000'
	option max_ul_shaper_rate_kbps '20000'
	option pinger_binary 'fping'
	option no_pingers '1'
	option reflector_ping_interval_s '0.2'
	option randomize_reflectors '0'
	option enable_sleep_function '0'
	option connection_active_thr_kbps '2000'
	option debug '0'
	list reflectors '10.0.3.2'
