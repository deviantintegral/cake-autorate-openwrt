# Never commit: browser binaries, deps, results, per-run VM/serve state.
node_modules/
test-results/
playwright-report/
blob-report/
.runtime/
*.log

# The review gallery is a build artifact, regenerated in CI, not source. The
# baseline PNGs under visual/*-snapshots/ are the real images and are committed
# on purpose, so they are deliberately not ignored here.
visual/gallery/
