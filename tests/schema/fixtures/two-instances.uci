# Multi-instance fixture: two cake-autorate instances on one router.
#
# Proves the schema needs no shared/global section -- each instance is a named
# section and the name is the instance id, so the generated daemon configs
# (/etc/cake-autorate/config.<name>.sh) and the log files
# (/var/log/cake-autorate.<name>.log) cannot collide.
#
# 'wan_dsl' is fully specified; 'wan_lte' is sparse -- it sets only the
# Essentials and inherits everything else. Both shapes must be legal.
#
# Also used by task 4's bridge tests (two enabled instances -> two config
# files) and by the task 10 VM run.

config cake-autorate 'wan_dsl'
	option enabled '1'
	option dl_if 'ifb4eth1'
	option ul_if 'eth1'
	option min_dl_shaper_rate_kbps '10000'
	option base_dl_shaper_rate_kbps '48000'
	option max_dl_shaper_rate_kbps '60000'
	option min_ul_shaper_rate_kbps '2000'
	option base_ul_shaper_rate_kbps '8000'
	option max_ul_shaper_rate_kbps '10000'
	option pinger_binary 'fping'
	option no_pingers '6'
	option reflector_ping_interval_s '0.3'
	list reflectors '1.1.1.1'
	list reflectors '8.8.8.8'
	list reflectors '9.9.9.9'
	list reflectors '2606:4700:4700::1111'
	list reflectors '2001:4860:4860::8888'
	list reflectors '2620:fe::fe'
	option dl_owd_delta_thr_ms '30.0'
	option ul_owd_delta_thr_ms '30.0'
	option output_summary_stats '1'
	option log_to_file '1'
	option debug '0'

config cake-autorate 'wan_lte'
	option enabled '1'
	option dl_if 'ifb4wwan0'
	option ul_if 'wwan0'
	option min_dl_shaper_rate_kbps '2000'
	option base_dl_shaper_rate_kbps '20000'
	option max_dl_shaper_rate_kbps '90000'
	option min_ul_shaper_rate_kbps '1000'
	option base_ul_shaper_rate_kbps '5000'
	option max_ul_shaper_rate_kbps '20000'
	option reflector_ping_interval_s '0.2'
	option ping_extra_args '-I wwan0'
